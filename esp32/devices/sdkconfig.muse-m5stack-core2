# M5Stack Core2 (K010, v1.0 with the AXP192 PMU): ESP32-D0WDQ6-V3 (classic
# ESP32, revision 3.0, 16 MB flash, 8 MB quad PSRAM), 2" 320x240 ILI9342C/E
# touch LCD (FT6336U), NS4168 speaker amp, PDM mic, and a CP2104 USB-UART
# bridge (10c4:ea60). The touchscreen runs the menus; PWR (the PMU's PEK key)
# talks. The v1.1 (AXP2101) needs CONFIG_BSP_PMU_AXP2101 instead.
# Sources: https://github.com/espressif/esp-bsp/tree/master/bsp/m5stack_core_2,
# https://docs.m5stack.com/en/core/Core2, M5Unified (src/M5Unified.inl,
# utility/power/AXP192_Class.inl) and M5GFX (src/M5GFX.cpp); esptool
# flash-id/chip-id on the board for the flash size and chip revision.
# Load last, after sdkconfig.defaults and sdkconfig.muse.
CONFIG_IDF_TARGET="esp32"
CONFIG_MUSE_BOARD_M5STACK_CORE2=y
# Signed apps without Secure Boot use the Secure Boot V2 (RSA) scheme, which
# the ESP32 supports from chip revision 3.0 (the D0WDQ6-V3 is one).
CONFIG_ESP32_REV_MIN_3=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
# Unused by Muse builds (PWR confirms pairing); GPIO0 is the mic clock and the
# speaker word select here.
CONFIG_HOMEHUB_BUTTON_GPIO=0

CONFIG_SPIRAM=y
# CONFIG_SPIRAM_IGNORE_NOTFOUND is not set
# Muse's voice task keeps its stack in PSRAM. Off by default on the ESP32 for
# the revision 1 PSRAM cache bug, which revision 3 (above) doesn't have.
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y

# Release the classic Bluetooth controller memory; pairing is BLE only.
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=n
CONFIG_BTDM_CTRL_MODE_BTDM=n

# The BSP drives the display, touch, speaker amp and PMU. AXP192 for the v1.0
# unit; the speaker takes I2S1, leaving I2S0 to the PDM mic (only I2S0 does
# PDM on the classic ESP32).
CONFIG_BSP_PMU_AXP192=y
CONFIG_BSP_I2S_NUM=1

# LVGL buffers stay small (10 lines, double-buffered) in board_m5stack_core2.c;
# this BSP has no Kconfig for them.
